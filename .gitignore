# --- KiCad local state — regenerated on every open. Nexus edd15f3d, 2026-08-22 ---
# NOTE: "*-backup/" does NOT match KiCad's "*-backups/" (plural). That
# one-character near-miss is why backup zips kept showing as untracked.
*.kicad_prl
*-backups/
fp-info-cache
*.lck
~*.lck
_autosave-*

# Scratch kicad-cli DRC output from manual investigation (kicad-cli pcb drc
# run by hand at a shell). The generator's own report is
# _deliverables/drc-report.txt, which is tracked and unaffected by this rule.
# An untracked *-drc.rpt left in a board dir trips hw_deliverables_gen.mjs's
# dirty check and stalls that board at 'warn' (Nexus 975de7f7, f81f825c).
*-drc.rpt
